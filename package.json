{
  "name": "union-next",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '@union/web' --filter '@union/worker' dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run build && bun run --filter '@union/web' --filter '@union/worker' start",
    "compose": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:changed": "bun scripts/lint-changed.ts",
    "map": "bun scripts/repo-map.ts",
    "active": "bun scripts/active.ts",
    "map:check": "bun scripts/repo-map.ts --check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run map:check && bun run lint && bun run sg && bun run knip && bun run dup && bun run secrets && bun run typecheck && bun test",
    "db:backup": "bun scripts/db-backup.ts",
    "db:restore": "bun scripts/db-restore.ts",
    "db:reset": "bun scripts/db-reset.ts",
    "usage:backfill": "bun scripts/usage-backfill.ts",
    "knip": "knip",
    "sg": "ast-grep scan && ast-grep test --skip-snapshot-tests",
    "dup": "jscpd --silent",
    "secrets": "gitleaks git --redact --no-banner --log-level warn && gitleaks git --pre-commit --redact --no-banner --log-level warn",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:development",
    "@types/bun": "catalog:development",
    "@union/core": "workspace:*",
    "husky": "catalog:development",
    "jscpd": "catalog:development",
    "knip": "catalog:development",
    "oxfmt": "catalog:development",
    "oxlint": "catalog:development",
    "oxlint-tsgolint": "catalog:development",
    "playwright-core": "catalog:development",
    "typescript": "catalog:development"
  },
  "catalogs": {
    "development": {
      "@ast-grep/cli": "0.51.0",
      "@types/bun": "1.4.2",
      "husky": "9.1.7",
      "jscpd": "5.4.2",
      "knip": "6.42.1",
      "oxfmt": "0.72.0",
      "oxlint": "1.87.0",
      "oxlint-tsgolint": "7.0.2004",
      "playwright-core": "1.56.1",
      "typescript": "7.0.2"
    },
    "ui": {
      "@dnd-kit/core": "6.3.1",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-query": "5.104.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "lowlight": "3.3.0",
      "mermaid": "12.2.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-markdown": "10.1.0",
      "rehype-raw": "7.0.0",
      "rehype-sanitize": "6.0.0",
      "remark-gfm": "4.0.1",
      "tailwindcss": "4.3.3",
      "vite": "8.3.4"
    },
    "server": {
      "@hono/bun": "1.0.1",
      "hono": "4.13.13"
    },
    "database": {
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.4"
    },
    "github": {
      "@octokit/auth-app": "8.3.1",
      "octokit": "5.0.5"
    }
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
